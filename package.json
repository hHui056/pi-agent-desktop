{
  "name": "pi-agent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Thin Electron shell that hosts the real pi coding-agent TUI",
  "main": "./out/main/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev-nosandbox.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "setup": "node scripts/ensure-electron.mjs && node scripts/seed-runtime.mjs",
    "seed:runtime": "node scripts/seed-runtime.mjs",
    "diagnose": "node scripts/diagnose.mjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dev:plain": "electron-vite dev"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
